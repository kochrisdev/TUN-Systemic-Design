{
  "name": "@tun-systemic/react",
  "version": "0.1.0",
  "description": "TUN Systemic Design React reference components",
  "private": true,
  "type": "module",
  "license": "CC0-1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./contracts": { "types": "./dist/contracts.d.ts", "import": "./dist/contracts.js" },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md", "LICENSE"],
  "peerDependencies": { "react": ">=18.3.0 <20", "react-dom": ">=18.3.0 <20" },
  "scripts": { "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs" }
}
