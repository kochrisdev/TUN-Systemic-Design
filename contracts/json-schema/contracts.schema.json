{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tun:contracts:0.1.0",
  "title": "TUN portable wire contracts",
  "description": "Select a named $defs entry. Cross-field algorithms are listed in x-tun-semantic-checks and contracts/SEMANTICS.md.",
  "not": {},
  "$defs": {
    "ActionProposal": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"action":{"$ref":"#/$defs/NonBlankText"},"target":{"$ref":"#/$defs/NonBlankText"},"actor":{"$ref":"#/$defs/Actor"},"consequence":{"$ref":"#/$defs/Consequence"},"effect":{"$ref":"#/$defs/NonBlankText"},"authority":{"$ref":"#/$defs/NonBlankText"},"recovery":{"$ref":"#/$defs/Recovery"},"expiresAt":{"$ref":"#/$defs/Timestamp"},"reviewBasis":{"$ref":"#/$defs/ReviewBasis"},"contentPreview":{"$ref":"#/$defs/NonBlankText"}},"required":["id","version","action","target","actor","consequence","effect","authority","recovery"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp"]},
    "ActivityRecord": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"actor":{"$ref":"#/$defs/Actor"},"task":{"$ref":"#/$defs/NonBlankText"},"scope":{"$ref":"#/$defs/NonBlankText"},"status":{"$ref":"#/$defs/ActivityStatus"},"effects":{"$ref":"#/$defs/NonBlankText"},"observedAt":{"$ref":"#/$defs/Timestamp"},"evidence":{"$ref":"#/$defs/NonBlankText"},"blocker":{"$ref":"#/$defs/NonBlankText"},"progress":{"type":"object","properties":{"completed":{"type":"number","minimum":0},"total":{"type":"number","exclusiveMinimum":0},"unit":{"$ref":"#/$defs/NonBlankText"}},"required":["completed","total","unit"],"additionalProperties":false}},"required":["id","version","actor","task","scope","status","effects","observedAt"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp","progress-range"]},
    "ActivityStatus": {"type":"string","enum":["idle","queued","running","waiting","verifying","completed","partial","failed","unknown"],"x-tun-semantic-checks":[]},
    "Actor": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"name":{"$ref":"#/$defs/NonBlankText"},"type":{"type":"string","enum":["human","agent","system"]}},"required":["id","name","type"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "AgentProfile": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"name":{"$ref":"#/$defs/NonBlankText"},"purpose":{"$ref":"#/$defs/NonBlankText"},"autonomy":{"$ref":"#/$defs/AutonomyLevel"},"authority":{"type":"array","items":{"$ref":"#/$defs/NonBlankText"}},"capabilities":{"type":"array","items":{"$ref":"#/$defs/NonBlankText"}}},"required":["id","name","purpose","autonomy","authority"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "AgentState": {"type":"string","enum":["idle","listening","thinking","planning","waiting","acting","verifying","blocked","completed","failed","escalated"],"x-tun-semantic-checks":[]},
    "ApprovalStatus": {"type":"string","enum":["awaiting","approved","rejected","expired","superseded"],"x-tun-semantic-checks":[]},
    "AutonomyLevel": {"anyOf":[{"type":"number","const":0},{"type":"number","const":1},{"type":"number","const":2},{"type":"number","const":3},{"type":"number","const":4}],"x-tun-semantic-checks":[]},
    "Consequence": {"type":"string","enum":["C0","C1","C2","C3","C4"],"x-tun-semantic-checks":[]},
    "ContextAvailability": {"type":"string","enum":["available","stale","missing","restricted"],"x-tun-semantic-checks":[]},
    "ContextPersistence": {"type":"string","enum":["task","session","persistent","operational"],"x-tun-semantic-checks":[]},
    "ContextSnapshot": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"scope":{"$ref":"#/$defs/NonBlankText"},"sources":{"type":"array","items":{"$ref":"#/$defs/ContextSource"}},"changeSummary":{"$ref":"#/$defs/NonBlankText"}},"required":["id","version","scope","sources"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp","url","unique-source-ids"]},
    "ContextSource": {"anyOf":[{"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"label":{"$ref":"#/$defs/NonBlankText"},"kind":{"type":"string","enum":["file","note","memory","tool","other"]},"scope":{"$ref":"#/$defs/NonBlankText"},"persistence":{"$ref":"#/$defs/ContextPersistence"},"provenance":{"type":"string","enum":["provided","retrieved","inferred"]},"availability":{"type":"string","enum":["available","stale"]},"usage":{"$ref":"#/$defs/ContextUsage"},"summary":{"$ref":"#/$defs/NonBlankText"},"detailsUrl":{"$ref":"#/$defs/DetailsUrl"},"observedAt":{"$ref":"#/$defs/Timestamp"}},"required":["id","label","kind","scope","persistence","provenance","availability","usage"],"additionalProperties":false},{"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"label":{"$ref":"#/$defs/NonBlankText"},"kind":{"type":"string","enum":["file","note","memory","tool","other"]},"scope":{"$ref":"#/$defs/NonBlankText"},"persistence":{"$ref":"#/$defs/ContextPersistence"},"provenance":{"type":"string","enum":["provided","retrieved","inferred"]},"availability":{"type":"string","enum":["missing","restricted"]},"usage":{"type":"string","const":"not-used"}},"required":["id","label","kind","scope","persistence","provenance","availability","usage"],"additionalProperties":false}],"x-tun-semantic-checks":["timestamp","url"]},
    "ContextUsage": {"type":"string","enum":["used","not-used","unknown"],"x-tun-semantic-checks":[]},
    "ControlEvidence": {"type":"object","properties":{"controlId":{"$ref":"#/$defs/NonBlankText"},"controlVersion":{"$ref":"#/$defs/NonBlankText"},"runId":{"$ref":"#/$defs/NonBlankText"},"runVersion":{"$ref":"#/$defs/NonBlankText"},"outcome":{"type":"string","enum":["completed","failed"]},"observedAt":{"$ref":"#/$defs/Timestamp"},"detail":{"$ref":"#/$defs/NonBlankText"}},"required":["controlId","controlVersion","runId","runVersion","outcome","observedAt","detail"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp"]},
    "ControlRequest": {"type":"object","properties":{"controlId":{"$ref":"#/$defs/NonBlankText"},"controlVersion":{"$ref":"#/$defs/NonBlankText"},"runId":{"$ref":"#/$defs/NonBlankText"},"runVersion":{"$ref":"#/$defs/NonBlankText"}},"required":["controlId","controlVersion","runId","runVersion"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "ControlStatus": {"type":"string","enum":["available","pending","acknowledged","completed","failed","unknown","unavailable"],"x-tun-semantic-checks":[]},
    "DecisionRequest": {"type":"object","properties":{"proposalId":{"$ref":"#/$defs/NonBlankText"},"proposalVersion":{"$ref":"#/$defs/NonBlankText"},"decision":{"type":"string","enum":["approve","reject"]}},"required":["proposalId","proposalVersion","decision"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "DetailsUrl": {"type":"string","pattern":"^(?:\\/(?:[^/\\\\\\x00-\\x20][^\\\\\\x00-\\x20]*)?|https?:\\/\\/[^\\\\\\x00-\\x20]+)$(?![\\s\\S])","x-tun-semantic-checks":["url"]},
    "EvidenceAccess": {"type":"string","enum":["available","unavailable","restricted"],"x-tun-semantic-checks":[]},
    "EvidenceCollection": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"claim":{"$ref":"#/$defs/NonBlankText"},"sources":{"type":"array","items":{"$ref":"#/$defs/EvidenceSource"}}},"required":["id","version","claim","sources"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp","url","unique-source-ids","evidence-metadata"]},
    "EvidenceExcerpt": {"type":"object","properties":{"kind":{"type":"string","enum":["quote","paraphrase","generated"]},"text":{"$ref":"#/$defs/NonBlankText"},"location":{"$ref":"#/$defs/NonBlankText"}},"required":["kind","text"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "EvidenceRelationship": {"type":"string","enum":["supports","contradicts","background"],"x-tun-semantic-checks":[]},
    "EvidenceSource": {"anyOf":[{"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"title":{"$ref":"#/$defs/NonBlankText"},"kind":{"$ref":"#/$defs/NonBlankText"},"relationship":{"$ref":"#/$defs/EvidenceRelationship"},"relationshipExplanation":{"$ref":"#/$defs/NonBlankText"},"access":{"type":"string","const":"available"},"excerpt":{"$ref":"#/$defs/EvidenceExcerpt"},"url":{"$ref":"#/$defs/DetailsUrl"},"observedAt":{"$ref":"#/$defs/Timestamp"},"verification":{"type":"object","properties":{"state":{"type":"string","enum":["verified","unverified"]},"detail":{"$ref":"#/$defs/NonBlankText"}},"required":["state","detail"],"additionalProperties":false}},"required":["id","title","kind","relationship","relationshipExplanation","access","verification"],"additionalProperties":false},{"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"title":{"$ref":"#/$defs/NonBlankText"},"kind":{"$ref":"#/$defs/NonBlankText"},"relationship":{"$ref":"#/$defs/EvidenceRelationship"},"relationshipExplanation":{"$ref":"#/$defs/NonBlankText"},"access":{"type":"string","enum":["unavailable","restricted"]},"reason":{"$ref":"#/$defs/NonBlankText"}},"required":["id","title","kind","relationship","relationshipExplanation","access","reason"],"additionalProperties":false}],"x-tun-semantic-checks":["timestamp","url"]},
    "EvidenceState": {"type":"string","enum":["verified","partial","conflicting","unavailable"],"x-tun-semantic-checks":[]},
    "InterventionKind": {"type":"string","enum":["pause","stop","cancel","take-control","revoke","escalate"],"x-tun-semantic-checks":[]},
    "InterventionOperation": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"run":{"$ref":"#/$defs/RevisionRef"},"actor":{"$ref":"#/$defs/Actor"},"target":{"$ref":"#/$defs/NonBlankText"},"scope":{"$ref":"#/$defs/NonBlankText"},"effect":{"$ref":"#/$defs/NonBlankText"},"limits":{"$ref":"#/$defs/NonBlankText"},"knownEffects":{"$ref":"#/$defs/NonBlankText"},"expiresAt":{"$ref":"#/$defs/Timestamp"},"kind":{"$ref":"#/$defs/InterventionKind"}},"required":["id","version","run","actor","target","scope","effect","limits","knownEffects","kind"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp"]},
    "MemoryInspectionRequest": {"type":"object","properties":{"memoryId":{"$ref":"#/$defs/NonBlankText"},"memoryVersion":{"$ref":"#/$defs/NonBlankText"}},"required":["memoryId","memoryVersion"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "MemoryRecord": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"type":{"$ref":"#/$defs/MemoryType"},"state":{"$ref":"#/$defs/MemoryState"},"scope":{"$ref":"#/$defs/NonBlankText"},"influence":{"$ref":"#/$defs/NonBlankText"},"retentionNotice":{"$ref":"#/$defs/NonBlankText"}},"required":["id","version","type","state","scope"],"additionalProperties":false,"x-tun-semantic-checks":["memory-state"]},
    "MemoryState": {"type":"string","enum":["active","inactive","unavailable"],"x-tun-semantic-checks":[]},
    "MemoryType": {"type":"string","enum":["M0","M1","M2","M3"],"x-tun-semantic-checks":[]},
    "NonBlankText": {"type":"string","pattern":"[^\\u0009-\\u000d\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]","x-tun-semantic-checks":[]},
    "PlanStatus": {"type":"string","enum":["proposed","approved","in-progress","changed","blocked","completed"],"x-tun-semantic-checks":[]},
    "PlanStep": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"title":{"$ref":"#/$defs/NonBlankText"},"detail":{"$ref":"#/$defs/NonBlankText"},"status":{"$ref":"#/$defs/PlanStepStatus"},"dependsOn":{"type":"array","items":{"$ref":"#/$defs/NonBlankText"}},"approvalRequired":{"type":"boolean"},"owner":{"$ref":"#/$defs/NonBlankText"},"completionEvidence":{"$ref":"#/$defs/NonBlankText"}},"required":["id","title","detail","status"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "PlanStepStatus": {"type":"string","enum":["pending","in-progress","waiting-approval","blocked","completed","skipped"],"x-tun-semantic-checks":[]},
    "ProposalStatus": {"type":"string","enum":["draft","ready","modified","approved","rejected","expired","superseded"],"x-tun-semantic-checks":[]},
    "ReceiptData": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"action":{"$ref":"#/$defs/NonBlankText"},"actor":{"$ref":"#/$defs/Actor"},"target":{"$ref":"#/$defs/NonBlankText"},"timestamp":{"$ref":"#/$defs/Timestamp"},"status":{"$ref":"#/$defs/ReceiptStatus"},"summary":{"$ref":"#/$defs/NonBlankText"},"verification":{"type":"object","properties":{"state":{"type":"string","enum":["verified","pending","unavailable"]},"detail":{"$ref":"#/$defs/NonBlankText"}},"required":["state","detail"],"additionalProperties":false},"recovery":{"$ref":"#/$defs/Recovery"},"detailsUrl":{"$ref":"#/$defs/DetailsUrl"}},"required":["id","action","actor","target","timestamp","status","summary","verification","recovery"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp","url"]},
    "ReceiptStatus": {"type":"string","enum":["completed","partially-completed","failed","reversed","pending-verification"],"x-tun-semantic-checks":[]},
    "Recovery": {"type":"object","properties":{"kind":{"type":"string","enum":["reversible","compensatable","irreversible","unknown"]},"description":{"$ref":"#/$defs/NonBlankText"}},"required":["kind","description"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "RecoveryKind": {"type":"string","enum":["undo","retry","restore","rollback","compensate","revise","reconcile"],"x-tun-semantic-checks":[]},
    "RecoveryOperation": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"run":{"$ref":"#/$defs/RevisionRef"},"actor":{"$ref":"#/$defs/Actor"},"target":{"$ref":"#/$defs/NonBlankText"},"scope":{"$ref":"#/$defs/NonBlankText"},"effect":{"$ref":"#/$defs/NonBlankText"},"limits":{"$ref":"#/$defs/NonBlankText"},"knownEffects":{"$ref":"#/$defs/NonBlankText"},"expiresAt":{"$ref":"#/$defs/Timestamp"},"kind":{"$ref":"#/$defs/RecoveryKind"},"originalOutcome":{"type":"string","enum":["known","unknown"]},"retrySafety":{"$ref":"#/$defs/NonBlankText"}},"required":["id","version","run","actor","target","scope","effect","limits","knownEffects","kind","originalOutcome"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp","recovery-policy"]},
    "ReviewBasis": {"type":"object","properties":{"context":{"$ref":"#/$defs/RevisionRef"},"plan":{"$ref":"#/$defs/RevisionRef"}},"required":["context","plan"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "ReviewRequest": {"type":"object","properties":{"proposalId":{"$ref":"#/$defs/NonBlankText"},"proposalVersion":{"$ref":"#/$defs/NonBlankText"}},"required":["proposalId","proposalVersion"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "RevisionRef": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"}},"required":["id","version"],"additionalProperties":false,"x-tun-semantic-checks":[]},
    "TaskPlan": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"context":{"$ref":"#/$defs/RevisionRef"},"objective":{"$ref":"#/$defs/NonBlankText"},"status":{"$ref":"#/$defs/PlanStatus"},"steps":{"minItems":1,"type":"array","items":{"$ref":"#/$defs/PlanStep"}},"expectedOutputs":{"minItems":1,"type":"array","items":{"$ref":"#/$defs/NonBlankText"}},"changeSummary":{"$ref":"#/$defs/NonBlankText"},"blockers":{"type":"array","items":{"$ref":"#/$defs/NonBlankText"}},"completionEvidence":{"$ref":"#/$defs/NonBlankText"}},"required":["id","version","context","objective","status","steps","expectedOutputs"],"additionalProperties":false,"x-tun-semantic-checks":["plan-graph"]},
    "Timestamp": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])","x-tun-semantic-checks":["timestamp"]},
    "ToolActivityRecord": {"type":"object","properties":{"id":{"$ref":"#/$defs/NonBlankText"},"version":{"$ref":"#/$defs/NonBlankText"},"actor":{"$ref":"#/$defs/Actor"},"task":{"$ref":"#/$defs/NonBlankText"},"scope":{"$ref":"#/$defs/NonBlankText"},"status":{"$ref":"#/$defs/ActivityStatus"},"effects":{"$ref":"#/$defs/NonBlankText"},"observedAt":{"$ref":"#/$defs/Timestamp"},"evidence":{"$ref":"#/$defs/NonBlankText"},"blocker":{"$ref":"#/$defs/NonBlankText"},"progress":{"type":"object","properties":{"completed":{"type":"number","minimum":0},"total":{"type":"number","exclusiveMinimum":0},"unit":{"$ref":"#/$defs/NonBlankText"}},"required":["completed","total","unit"],"additionalProperties":false},"tool":{"$ref":"#/$defs/NonBlankText"},"category":{"$ref":"#/$defs/ToolCategory"},"target":{"$ref":"#/$defs/NonBlankText"},"authority":{"$ref":"#/$defs/NonBlankText"}},"required":["id","version","actor","task","scope","status","effects","observedAt","tool","category","target","authority"],"additionalProperties":false,"x-tun-semantic-checks":["timestamp","progress-range"]},
    "ToolCategory": {"type":"string","enum":["searching","reading","writing","sending","publishing","transacting","executing-code","accessing-private-data","changing-permissions"],"x-tun-semantic-checks":[]},
    "UncertaintyAssessment": {"type":"object","properties":{"scope":{"$ref":"#/$defs/NonBlankText"},"level":{"$ref":"#/$defs/UncertaintyLevel"},"explanation":{"$ref":"#/$defs/NonBlankText"},"basis":{"$ref":"#/$defs/NonBlankText"},"nextStep":{"$ref":"#/$defs/NonBlankText"}},"required":["scope","level","explanation"],"additionalProperties":false,"x-tun-semantic-checks":["uncertainty-basis"]},
    "UncertaintyLevel": {"type":"string","enum":["U0","U1","U2","U3"],"x-tun-semantic-checks":[]}
  }
}
